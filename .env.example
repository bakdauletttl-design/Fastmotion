# Обязательно: канал на Twitch (ник стримера)
TWITCH_CHANNEL=имя_канала

# Telegram: токен от @BotFather и id чата (узнать можно у @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Длина клипа: секунд до и после момента
CLIP_PRE_ROLL=20
CLIP_POST_ROLL=10
CLIP_COOLDOWN=45

# Чувствительность к чату
CHAT_MULTIPLIER=3.0
CHAT_MIN_MESSAGES=15
# HYPE_WORDS=kekw,pog,lul,клип

# Чувствительность к звуку
AUDIO_ENABLED=1
AUDIO_DB_ABOVE=8

STREAM_QUALITY=best
PORT=8000
