# Адрес сервера HypeCut Cloud (из cloud/.env, PUBLIC_URL)
EXPO_PUBLIC_API_URL=https://api.hypecut.app
# Google Cloud Console → Credentials → OAuth client ID (Web и iOS)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# RevenueCat → Project → API keys (публичные ключи iOS и Android)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# 1 = кнопка «Тестовый вход» (сервер должен быть с DEV_LOGIN=1)
EXPO_PUBLIC_DEV_LOGIN=0
