# Домен сервера, например api.hypecut.app (нужен для HTTPS)
DOMAIN=
PUBLIC_URL=https://api.hypecut.app

# Общий бот: создайте его в @BotFather и вставьте токен и имя (без @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=HypeCut_bot

# Любая длинная случайная строка (например, 64 случайных символа). Не меняйте после запуска.
JWT_SECRET=

# Вход: Client ID из Google Cloud Console (через запятую, если их несколько: iOS, Android, Web)
GOOGLE_CLIENT_IDS=
# Вход через Apple: Bundle ID приложения, например app.hypecut
APPLE_BUNDLE_IDS=app.hypecut

# Оплата: секрет вебхука RevenueCat (Project settings → Webhooks → Authorization header)
REVENUECAT_WEBHOOK_SECRET=

# Секрет для /admin/block (убрать канал по просьбе стримера)
ADMIN_TOKEN=

# Ссылка на приложение в магазине (кнопка в боте)
APP_URL=

# Сколько стримов сервер пишет одновременно
MAX_STREAMS=20
# Вход без Apple/Google для тестов. В продакшене оставьте 0.
DEV_LOGIN=0
